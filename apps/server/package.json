{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -b ../../packages/api && tsdown",
    "check-types": "tsc -b ../../packages/api && tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "start": "bun run dist/index.mjs",
    "dev:bare": "bun run --hot src/index.ts",
    "env:generate": "varlock codegen"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@sinclair/typebox": "^0.34.52",
    "@trips-app/api": "workspace:*",
    "@trips-app/db": "workspace:*",
    "elysia": "^1.4.30",
    "evlog": "catalog:",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@trips-app/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  }
}
